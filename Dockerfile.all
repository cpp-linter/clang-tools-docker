# check=skip=InvalidDefaultArgInFrom
# One image with clang-format and clang-tidy of every LLVM version from 12 on,
# built from the cpp-linter static binaries:
# https://github.com/cpp-linter/clang-tools-static-binaries
# docker-bake.hcl sets every ARG below, so they have no defaults.
ARG BASE_IMAGE

# ---- fetch: download and verify the binaries for the target platform ----
FROM --platform=$BUILDPLATFORM alpine:3.24 AS fetch
# RELEASES is a list of <major>=<version>=<release tag>, separated by spaces.
ARG RELEASES
ARG TARGETARCH
SHELL ["/bin/ash", "-eo", "pipefail", "-c"]
RUN apk add --no-cache curl
WORKDIR /dl
RUN mkdir -p /out/usr/bin \
    && for item in $RELEASES; do \
        major="${item%%=*}"; rest="${item#*=}"; version="${rest%%=*}"; tag="${rest#*=}"; \
        base="https://github.com/cpp-linter/clang-tools-static-binaries/releases/download/${tag}"; \
        src="https://raw.githubusercontent.com/llvm/llvm-project/llvmorg-${version}"; \
        prefix="/out/usr/lib/llvm-${major}"; \
        tools="clang-format clang-tidy clang-apply-replacements"; \
        files="clang-resource-headers-${major}.tar.gz"; \
        for tool in $tools; do files="$files ${tool}-${major}_linux-${TARGETARCH}"; done; \
        mkdir -p "$prefix/bin" \
        && curl --proto =https --tlsv1.2 -fsSL --retry 5 -o "SHA512SUMS-${major}" "$base/SHA512SUMS" \
        && for f in $files; do curl --proto =https --tlsv1.2 -fsSL --retry 5 -O "$base/$f"; done \
        && for f in $files; do grep -E "  ${f}\$" "SHA512SUMS-${major}"; done > "checksums-${major}" \
        && [ "$(wc -l < "checksums-${major}")" -eq "$(echo "$files" | wc -w)" ] \
        && sha512sum -c "checksums-${major}" \
        && for tool in $tools; do \
            install -m 0755 "${tool}-${major}_linux-${TARGETARCH}" "$prefix/bin/$tool"; \
            ln -s "../lib/llvm-${major}/bin/$tool" "/out/usr/bin/${tool}-${major}"; \
        done \
        # The headers tarball unpacks to lib/clang/<version>/include, next to bin/.
        && tar -xzf "clang-resource-headers-${major}.tar.gz" -C "$prefix" \
        # The Python helper scripts that Ubuntu's clang-tidy-N and clang-format-N
        # packages ship, from the same LLVM release as the binaries.
        && curl --proto =https --tlsv1.2 -fsSL --retry 5 -o "$prefix/bin/run-clang-tidy" "$src/clang-tools-extra/clang-tidy/tool/run-clang-tidy.py" \
        && curl --proto =https --tlsv1.2 -fsSL --retry 5 -o "$prefix/bin/clang-tidy-diff.py" "$src/clang-tools-extra/clang-tidy/tool/clang-tidy-diff.py" \
        && curl --proto =https --tlsv1.2 -fsSL --retry 5 -o "$prefix/bin/clang-format-diff.py" "$src/clang/tools/clang-format/clang-format-diff.py" \
        && curl --proto =https --tlsv1.2 -fsSL --retry 5 -o "$prefix/bin/git-clang-format" "$src/clang/tools/clang-format/git-clang-format" \
        && chmod 0755 "$prefix/bin/run-clang-tidy" "$prefix/bin/clang-tidy-diff.py" "$prefix/bin/clang-format-diff.py" "$prefix/bin/git-clang-format" \
        # Up to LLVM 16 some of them start with "#!/usr/bin/env python", a command Ubuntu does not have.
        && for script in run-clang-tidy clang-tidy-diff.py clang-format-diff.py git-clang-format; do \
            sed -i '1s|^#!/usr/bin/env python$|#!/usr/bin/env python3|' "$prefix/bin/$script"; \
        done \
        && ln -s "../lib/llvm-${major}/bin/run-clang-tidy" "/out/usr/bin/run-clang-tidy-${major}" \
        && ln -s "../lib/llvm-${major}/bin/clang-tidy-diff.py" "/out/usr/bin/clang-tidy-diff-${major}.py" \
        && ln -s "../lib/llvm-${major}/bin/clang-format-diff.py" "/out/usr/bin/clang-format-diff-${major}" \
        && ln -s "../lib/llvm-${major}/bin/git-clang-format" "/out/usr/bin/git-clang-format-${major}" \
        || exit 1; \
    done

# ---- final image ----
FROM $BASE_IMAGE
ARG RELEASES

LABEL \
    org.opencontainers.image.vendor="cpp-linter team" \
    org.opencontainers.image.title="Clang Tools Docker image" \
    org.opencontainers.image.description="The Clang Tools Docker image includes the clang-format and clang-tidy." \
    org.opencontainers.image.version="clang-tools:all" \
    org.opencontainers.image.url="https://github.com/cpp-linter/clang-tools-docker/pkgs/container/clang-tools" \
    org.opencontainers.image.source="https://github.com/cpp-linter/clang-tools-docker" \
    org.opencontainers.image.licenses="Apache-2.0 WITH LLVM-exception" \
    io.github.cpp-linter.static-binaries.releases="${RELEASES}"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# The C and C++ standard library headers clang-tidy needs to parse code (the
# libstdc++ of the distribution's default GCC), Python for run-clang-tidy and
# the other helper scripts, and git for git-clang-format and for the diffs that
# clang-format-diff and clang-tidy-diff read.
# A repository mounted from the host belongs to another user than the
# container's root, so git would refuse to read it; safe.directory allows it.
RUN apt-get update \
    && gcc_major="$(apt-cache show g++ | sed -n 's/^Depends:.* g++-\([0-9][0-9]*\).*/\1/p' | head -n 1)" \
    && [ -n "$gcc_major" ] \
    && apt-get --no-install-recommends -y install git libc6-dev "libstdc++-${gcc_major}-dev" python3 \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'

COPY --from=fetch /out/ /

# Integrity testing: the right version of every tool, every clang-tidy finds
# both clang's builtin headers and the C++ standard library, and the helper
# scripts start.
RUN printf '#include <stddef.h>\n#include <string>\nint main() { std::string s; return static_cast<int>(s.size() + sizeof(size_t)); }\n' > /tmp/check.cpp \
    && for item in $RELEASES; do \
        major="${item%%=*}"; rest="${item#*=}"; version="${rest%%=*}"; \
        "clang-format-${major}" --version | grep -F "clang-format version ${version}" \
        && "clang-tidy-${major}" --version | grep -F "LLVM version ${version}" \
        && "clang-tidy-${major}" --checks='-*,bugprone-*' --warnings-as-errors='*' /tmp/check.cpp -- -std=c++17 \
        || exit 1; \
        # The scripts are started with python3 and their first line is only
        # read, as in Dockerfile.
        for script in "run-clang-tidy-${major}" "clang-tidy-diff-${major}.py" "clang-format-diff-${major}" "git-clang-format-${major}"; do \
            head -n 1 "$(command -v "$script")" | grep -Fx '#!/usr/bin/env python3' > /dev/null \
            && python3 "$(command -v "$script")" -h > /dev/null \
            || exit 1; \
        done; \
    done \
    && rm /tmp/check.cpp

WORKDIR /src

CMD [""]
