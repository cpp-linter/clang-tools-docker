# check=skip=InvalidDefaultArgInFrom
# BASE_IMAGE has no default on purpose: docker-bake.hcl sets it for every target.
ARG BASE_IMAGE
FROM $BASE_IMAGE

LABEL \
    org.opencontainers.image.vendor="cpp-linter team" \
    org.opencontainers.image.title="Clang Tools Docker image" \
    org.opencontainers.image.description="The Clang Tools Docker image includes the clang-format and clang-tidy." \
    org.opencontainers.image.version="clang-tools:all" \
    org.opencontainers.image.url="https://hub.docker.com/r/xianpengshen/clang-tools" \
    org.opencontainers.image.source="https://github.com/cpp-linter/clang-tools-docker" \
    org.opencontainers.image.licenses="Apache-2.0 WITH LLVM-exception"

ENV CLANG_VERSIONS="12 11 10 9"

RUN set -e \
    && apt-get update \
    && for CLANG_VERSION in $CLANG_VERSIONS; do \
        apt-get --no-install-recommends -y install clang-format-$CLANG_VERSION clang-tidy-$CLANG_VERSION; done \
    && rm -rf /var/lib/apt/lists/*

ENV CLANG_VERSIONS="21 20 19 18 17 16 15 14 13"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -e \
    && apt-get update \
    && apt-get --no-install-recommends -y install gnupg lsb-release software-properties-common wget \
    && wget --quiet --tries=5 --retry-connrefused https://apt.llvm.org/llvm.sh \
    && chmod +x llvm.sh \
    # apt.llvm.org is flaky: retry llvm.sh, and exit explicitly because set -e
    # does not apply inside a loop that is part of an && list.
    && for CLANG_VERSION in $CLANG_VERSIONS; do \
        for ATTEMPT in 1 2 3; do \
            ./llvm.sh $CLANG_VERSION && break; \
            [ $ATTEMPT -lt 3 ] || { echo "llvm.sh $CLANG_VERSION failed after $ATTEMPT attempts" >&2; exit 1; }; \
            echo "llvm.sh $CLANG_VERSION failed (attempt $ATTEMPT), retrying in 15s" >&2; \
            sleep 15; \
        done; \
        apt-get --no-install-recommends -y install clang-format-$CLANG_VERSION clang-tidy-$CLANG_VERSION || exit 1; \
    done \
    && rm llvm.sh \
    && rm -rf /var/lib/apt/lists/*

ENV CLANG_VERSIONS="21 20 19 18 17 16 15 14 13 12 11 10 9"
# Integrity testing
RUN set -e \
    && for VERSION in $CLANG_VERSIONS; do \
        clang-format-$VERSION --version | grep -E "clang-format version $VERSION"; \
        clang-tidy-$VERSION --version | grep "LLVM version $VERSION"; \
    done

WORKDIR /src

CMD [""]
